# ==============================================================================
# SAHAAY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Groq LLM API Key (for real-time document extraction and RAG assistance)
GROQ_API_KEY=your_groq_api_key_here

# LlamaCloud / LlamaParse API Key (optional fallback parser)
LLAMA_CLOUD_API_KEY=your_llamacloud_api_key_here

# Primary Production Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sahaay

# Local Development Fallback Database (SQLite)
FALLBACK_DATABASE_URL=sqlite+aiosqlite:///./sahaay.db

# Application Security
SECRET_KEY=generate_a_secure_random_key_for_production

# Upload Directory for Evidence & Documents
UPLOAD_DIR=./uploads

# Paytm Payment Gateway Integration (Leave empty for simulated sandbox mode)
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_CALLBACK_URL=http://localhost:8000/payments/callback

# Allowed CORS Origins (comma-separated or wildcard for local dev)
CORS_ORIGINS=*
